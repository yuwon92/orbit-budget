{
  "name": "orbit-suite",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "dev:orbit": "vite --config apps/orbit/vite.config.ts",
    "dev:wish": "vite --config apps/wish/vite.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:wish && npm run build:orbit",
    "build:orbit": "tsc -p apps/orbit/tsconfig.app.json && vite build --config apps/orbit/vite.config.ts",
    "build:wish": "tsc -p apps/wish/tsconfig.app.json && vite build --config apps/wish/vite.config.ts",
    "verify": "node scripts/verify-budget.ts && node scripts/verify-wish.ts",
    "preview": "npm run preview:orbit",
    "preview:orbit": "vite preview --config apps/orbit/vite.config.ts",
    "preview:wish": "vite preview --config apps/wish/vite.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vite-plugin-pwa": "^1.3.0"
  }
}
